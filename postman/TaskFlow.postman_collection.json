              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Hepsi completed\", () => pm.response.json().data.forEach(t => pm.expect(t.status).to.eql(\"completed\")));"
                ]
              }
            }
